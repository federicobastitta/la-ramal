rules_version = '2';

// Reglas de seguridad de LA RAMAL.
// El rol ("chofer", "trafico", "taller", "personal", "admin", "delegado") y la línea vienen en los
// custom claims del usuario; los pone solo la función altaDePersona. Nadie puede escribir su propio rol.
service cloud.firestore {
  match /databases/{database}/documents {
    function dentro() { return request.auth != null; }
    function deLinea(l) { return dentro() && request.auth.token.linea == l; }
    function rol() { return request.auth.token.rol; }
    function empresa(l) { return deLinea(l) && rol() in ['trafico', 'taller', 'personal', 'admin']; }
    function chofer(l) { return deLinea(l) && rol() == 'chofer'; }
    // Papeles de las personas (sueldos, salud): solo tráfico, personal y admin. El taller no.
    function gestion(l) { return deLinea(l) && rol() in ['trafico', 'personal', 'admin']; }
    function sueldos(l) { return deLinea(l) && rol() in ['personal', 'admin']; }
    function propio() { return resource.data.choferId == request.auth.uid; }
    function nuevo() { return request.resource.data; }
    function cambia() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function ubicacionValida(u) {
      return u is map && u.keys().hasOnly(['lat', 'lng', 'precisionM', 'en'])
        && u.lat is number && u.lat >= -90 && u.lat <= 90
        && u.lng is number && u.lng >= -180 && u.lng <= 180
        && u.precisionM is number && u.precisionM >= 0 && u.en is number;
    }

    match /lineas/{l} {
      allow read: if deLinea(l);
      allow write: if false;

      match /reportes/{id} {
        // El chofer ve sus reportes y los cortes/choques/embotellamientos de su línea (para "Cortes en vivo").
        allow read: if empresa(l)
          || (chofer(l) && (resource.data.choferId == request.auth.uid || resource.data.tipo in ['corte', 'embotellamiento', 'choque', 'calle']));

        // Crear: solo el chofer, a su nombre, en su línea, recién recibido y sin clasificar (eso lo hace el servidor).
        allow create: if chofer(l)
          && nuevo().keys().hasOnly(['id', 'lineaId', 'cocheId', 'choferId', 'tipo', 'texto', 'ubicacion', 'creadoEn', 'adjuntos', 'estado', 'recibidoEn'])
          && nuevo().id == id && nuevo().lineaId == l && nuevo().choferId == request.auth.uid
          && nuevo().estado == 'recibido'
          && nuevo().tipo in ['coche', 'embotellamiento', 'choque', 'agresor', 'corte', 'calle', 'otro']
          && nuevo().texto is string && nuevo().texto.size() <= 1000
          && nuevo().cocheId is string && nuevo().cocheId.size() > 0
          && nuevo().adjuntos is list && nuevo().adjuntos.size() <= 6
          && nuevo().creadoEn is number
          && ubicacionValida(nuevo().ubicacion);

        // Cambiar el estado: solo la empresa, y solo el estado.
        allow update: if empresa(l)
          && cambia().hasOnly(['estado', 'actualizadoEn'])
          && nuevo().estado in ['recibido', 'en_taller', 'publicado', 'caso_tomado', 'cerrado'];

        allow delete: if false;
      }

      match /panicos/{id} {
        // Si se "canceló" con el PIN de coacción, el chofer ya no puede leerla (en su celular se ve cerrada).
        allow read: if empresa(l)
          || (chofer(l) && resource.data.choferId == request.auth.uid && resource.data.get('coaccion', false) == false);

        allow create: if chofer(l)
          && nuevo().keys().hasOnly(['id', 'lineaId', 'cocheId', 'choferId', 'estado', 'desde', 'ubicaciones', 'origen'])
          && nuevo().id == id && nuevo().lineaId == l && nuevo().choferId == request.auth.uid
          && nuevo().estado == 'activa'
          && nuevo().origen in ['boton_bluetooth', 'pantalla', 'prueba']
          && nuevo().ubicaciones is list && nuevo().ubicaciones.size() <= 5;

        // El chofer solo suma posiciones (nunca cierra: eso lo hace el servidor con el PIN).
        // La empresa solo confirma.
        allow update: if (chofer(l) && resource.data.choferId == request.auth.uid && resource.data.estado != 'cerrada'
              && cambia().hasOnly(['ubicaciones']) && nuevo().ubicaciones.size() <= 500)
          || (empresa(l) && resource.data.estado == 'activa' && nuevo().estado == 'confirmada'
              && cambia().hasOnly(['estado', 'confirmadaEn']));

        allow delete: if false;
      }

      match /personas/{uid} {
        allow read: if (deLinea(l) && request.auth.uid == uid) || empresa(l);
        allow write: if false;
      }

      // Hashes de los PIN e intentos fallidos: solo el servidor.
      match /privado/{uid} {
        allow read, write: if false;
      }

      match /auditoria/{doc} {
        allow read: if deLinea(l) && rol() == 'admin';
        allow write: if false;
      }

      // ---------------- Etapa 2: papeles y personal ----------------

      // Planillas: las publica tráfico; el chofer ve las suyas. El intercambio por cambio de turno lo hace el servidor.
      match /planillas/{id} {
        allow read: if gestion(l) || (chofer(l) && propio());
        allow create, update: if gestion(l) && nuevo().lineaId == l && nuevo().id == id;
        allow delete: if false;
      }

      // Recibos: los sube personal. El chofer solo da la conformidad, atada al hash del PDF que está viendo.
      match /recibos/{id} {
        allow read: if sueldos(l) || (chofer(l) && propio());
        allow create: if (sueldos(l) && nuevo().lineaId == l && !('conformidad' in nuevo()))
          // El chofer puede subir la foto de su propio recibo en papel (la lee la IA; no lleva conformidad).
          || (chofer(l) && nuevo().choferId == request.auth.uid && nuevo().lineaId == l && nuevo().origen == 'chofer'
              && !nuevo().keys().hasAny(['conformidad', 'basico', 'extras', 'antiguedad', 'antiguedadAnios', 'viaticos', 'presentismo', 'bonoKm']));
        allow update: if (sueldos(l) && !cambia().hasAny(['conformidad', 'choferId']))
          || (chofer(l) && propio() && cambia().hasOnly(['conformidad'])
              && nuevo().conformidad.keys().hasOnly(['en', 'sha256'])
              && nuevo().conformidad.sha256 == resource.data.sha256);
        allow delete: if false;
      }

      // Certificados: los carga el chofer (pendientes); los valida gestión.
      match /certificados/{id} {
        allow read: if gestion(l) || (chofer(l) && propio());
        allow create: if chofer(l) && nuevo().choferId == request.auth.uid && nuevo().lineaId == l && nuevo().id == id
          && nuevo().estado == 'pendiente';
        allow update: if gestion(l) && cambia().hasOnly(['estado', 'motivo']) && nuevo().estado in ['validado', 'rechazado'];
        allow delete: if false;
      }

      // Pedidos, con la misma máquina de estados que transicionPedido del núcleo.
      match /pedidos/{id} {
        allow read: if gestion(l) || (chofer(l) && (propio()
          || (resource.data.tipo == 'cambio_turno' && resource.data.estado == 'ofrecido')
          || resource.data.get('tomadoPor', '') == request.auth.uid));

        allow create: if chofer(l) && nuevo().choferId == request.auth.uid && nuevo().lineaId == l && nuevo().id == id
          && !nuevo().keys().hasAny(['tomadoPor', 'tomadoPorNombre', 'respuesta', 'rutaRespuesta'])
          && ((nuevo().tipo == 'cambio_turno' && nuevo().estado == 'ofrecido')
              || (nuevo().tipo in ['certificado_trabajo', 'certificado_haberes', 'parte_enfermo', 'vacaciones'] && nuevo().estado == 'pendiente'));

        allow update: if
          // Un compañero lo toma.
          (chofer(l) && !propio() && resource.data.tipo == 'cambio_turno' && resource.data.estado == 'ofrecido'
            && nuevo().estado == 'tomado' && nuevo().tomadoPor == request.auth.uid
            && cambia().hasOnly(['estado', 'tomadoPor', 'tomadoPorNombre', 'actualizadoEn']))
          // El que lo tomó lo suelta.
          || (chofer(l) && resource.data.get('tomadoPor', '') == request.auth.uid && resource.data.estado == 'tomado'
            && nuevo().estado == 'ofrecido' && !nuevo().keys().hasAny(['tomadoPor', 'tomadoPorNombre'])
            && cambia().hasOnly(['estado', 'tomadoPor', 'tomadoPorNombre', 'actualizadoEn']))
          // Quien lo pidió lo cancela antes de la respuesta.
          || (chofer(l) && propio() && resource.data.estado in ['pendiente', 'ofrecido', 'tomado']
            && nuevo().estado == 'cancelado' && cambia().hasOnly(['estado', 'actualizadoEn']))
          // Gestión responde. Un cambio de turno se aprueba solo si ya lo tomó un compañero.
          || (gestion(l) && resource.data.estado in ['pendiente', 'ofrecido', 'tomado']
            && nuevo().estado in ['aprobado', 'rechazado', 'entregado']
            && !(resource.data.tipo == 'cambio_turno' && nuevo().estado == 'aprobado' && resource.data.estado != 'tomado')
            && cambia().hasOnly(['estado', 'respuesta', 'rutaRespuesta', 'actualizadoEn']));
        allow delete: if false;
      }

      // Avisos de la empresa: los lee toda la línea; el chofer solo se agrega a "leídos".
      match /comunicados/{id} {
        allow read: if deLinea(l);
        allow create: if gestion(l) && nuevo().lineaId == l && nuevo().leidos.size() == 0;
        allow update: if (gestion(l) && !cambia().hasAny(['leidos']))
          || (deLinea(l) && cambia().hasOnly(['leidos'])
              && nuevo().leidos.toSet().difference(resource.data.leidos.toSet()) == [request.auth.uid].toSet()
              && resource.data.leidos.toSet().difference(nuevo().leidos.toSet()).size() == 0);
        allow delete: if false;
      }

      // Mensajes de la terminal por la radio: los manda gestión (tráfico) y los oye toda la línea. No se tocan ni se borran.
      match /mensajesRadio/{id} {
        allow read: if deLinea(l);
        allow create: if gestion(l) && nuevo().lineaId == l && nuevo().id == id
          && nuevo().texto is string && nuevo().texto.size() > 0 && nuevo().texto.size() <= 280
          && nuevo().para is string && nuevo().para.size() > 0 && nuevo().para.size() <= 40;
        allow update, delete: if false;
      }

      // Resumen del día medido por el GPS: lo escribe el celular del chofer; lo lee él y gestión.
      match /jornadas/{id} {
        allow read: if gestion(l) || (chofer(l) && propio());
        allow create, update: if chofer(l) && nuevo().choferId == request.auth.uid && nuevo().lineaId == l && nuevo().id == id
          && id.matches(request.auth.uid + '-[0-9]{4}-[0-9]{2}-[0-9]{2}') && nuevo().vueltas.size() <= 30;
        allow delete: if false;
      }

      // Escala del convenio: la lee toda la línea (cada chofer ve su cuenta); la cargan personal, admin o el delegado.
      match /escalas/{id} {
        allow read: if deLinea(l);
        allow write: if deLinea(l) && rol() in ['personal', 'admin', 'delegado'];
      }

      // Recorrido de la línea (cabeceras, paradas, trazado): lo carga tráfico.
      match /configuracion/{id} {
        allow read: if deLinea(l);
        allow write: if deLinea(l) && rol() in ['trafico', 'admin'];
      }

      // Canal del gremio: lo leen choferes y delegados; la empresa NO. Escribe solo el delegado.
      match /gremio/{doc=**} {
        allow read: if deLinea(l) && rol() in ['chofer', 'delegado'];
        allow write: if deLinea(l) && rol() == 'delegado';
      }
    }
  }
}
