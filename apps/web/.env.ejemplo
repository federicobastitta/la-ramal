# Sin estas variables la app arranca en modo demo (sin servidor).
# Con ellas, usa el proyecto de Firebase. Copiar a .env.local y completar con los datos de
# Consola de Firebase › Configuración del proyecto › Tus apps › App web.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
